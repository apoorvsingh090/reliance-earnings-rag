# Copy to .env and fill in. NEVER commit real secrets.
# LLM provider (Milestone 6) — exactly one key is needed when LLM is wired up.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

# Postgres + pgvector (Milestones 2-3). Local default matches docker-compose.yml.
DATABASE_URL=postgresql+psycopg://reliance:reliance@localhost:5432/reliance_rag
PGVECTOR_DIM=384

# Retrieval (M3). Must match the embedding model dimensionality.
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384

# App
APP_ENV=local
DATA_DIR=data
LOG_LEVEL=INFO
